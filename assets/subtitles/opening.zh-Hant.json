  "cues": [
    {
      "start_ms": 45760,
      "end_ms": 47060,
      "ja": "入るぞ",
      "text": "我進來了。"
    },
    {
      "start_ms": 51870,
      "end_ms": 54750,
      "ja": "そろそろ始めようと思うんだが",
      "text": "我想差不多該開始了。"
    },
    {
      "start_ms": 60540,
      "end_ms": 62300,
      "ja": "もう10年になるか",
      "text": "已經十年了啊。"
    },
    {
      "start_ms": 62600,
      "end_ms": 65460,
      "ja": "娘さん夫婦がこの島で遭難したのは",
      "text": "自從你女兒和女婿在這座島上遇難以來。"
    },
    {
      "start_ms": 66710,
      "end_ms": 69490,
      "ja": "馬鹿じゃよ二人とも",
      "text": "真是兩個傻孩子啊..."
    },
    {
      "start_ms": 70670,
      "end_ms": 74510,
      "ja": "幼い子を残したまま行ってしまいよって",
      "text": "竟然丟下還小的孩子，\n就這樣走了。"
    },
    {
      "start_ms": 77590,
      "end_ms": 82850,
      "ja": "なあ思い直さんかあれに手を出すのは",
      "text": "我說，你就不能再考慮一下嗎？\n那個東西，還是別去碰了。"
    },
    {
      "start_ms": 84020,
      "end_ms": 85690,
      "ja": "今さら辞められん",
      "text": "事到如今，怎麼能放棄。"
    },
    {
      "start_ms": 85960,
      "end_ms": 88780,
      "ja": "わしの人生すべてあれにかけたんだ",
      "text": "我把這一生，全都賭在那上面了。"
    },
    {
      "start_ms": 89280,
      "end_ms": 91240,
      "ja": "今さら辞められるか",
      "text": "怎能在這時候放棄！"
    },
    {
      "start_ms": 91440,
      "end_ms": 93360,
      "ja": "ウェルナーフォンミュラー様",
      "text": "渥爾納・馮・謬拉大人！"
    },
    {
      "start_ms": 93620,
      "end_ms": 94240,
      "ja": "ん?",
      "text": "嗯？"
    },
    {
      "start_ms": 94380,
      "end_ms": 95600,
      "ja": "おーいかんいかん",
      "text": "啊，糟了、糟了！"
    },
    {
      "start_ms": 96060,
      "end_ms": 97830,
      "ja": "じゃあ先に行っとるからな",
      "text": "那我就先過去了。"
    },
    {
      "start_ms": 101820,
      "end_ms": 104850,
      "ja": "結局お孫さんは来なかったんだな",
      "text": "結果，你孫女還是沒來啊。"
    },
    {
      "start_ms": 105080,
      "end_ms": 105850,
      "ja": "え?",
      "text": "嗯？"
    },
    {
      "start_ms": 106480,
      "end_ms": 107280,
      "ja": "あぁ…",
      "text": "是啊...",
      "review_id": "written-recheck-opening-acknowledgment",
